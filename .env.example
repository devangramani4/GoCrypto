# ─────────────────────────────────────────────────────────────────────────────
# GoCrypto environment configuration. Copy to `.env` (never commit real values).
# Generate secrets with:  openssl rand -base64 48   (JWT)   openssl rand -base64 32  (ENCRYPTION_KEY)
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
# development | staging | production
APP_ENV=development
# SANDBOX = paper trading with simulated custody (default).
# LIVE requires LIVE_TRADING_ACKNOWLEDGEMENT=REGULATORY_REVIEW_COMPLETED after legal/regulatory review
# (custody, exchange, derivatives, KYC/AML, tax) for every jurisdiction you operate in.
TRADING_MODE=SANDBOX
LIVE_TRADING_ACKNOWLEDGEMENT=
LOG_LEVEL=info
LOG_PRETTY=true

# ── HTTP / WebSocket ──
API_HOST=0.0.0.0
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_APP_URL=http://localhost:5173
ADMIN_APP_URL=http://localhost:5174
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
TRUST_PROXY=false
WS_PORT=4001
WS_PATH=/socket.io
# Bearer token required to scrape /metrics (empty = open, keep it internal-only)
METRICS_TOKEN=

# ── Data stores ──
DATABASE_URL=mysql://gocrypto:change_me@127.0.0.1:3306/gocrypto
DATABASE_POOL_SIZE=20
REDIS_URL=redis://127.0.0.1:6379/0

# ── Auth & secrets ──
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string-32+
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_SEC=2592000
# base64 encoded 32-byte key (AES-256-GCM for 2FA secrets and API-key secrets)
ENCRYPTION_KEY=
# Comma separated internal service API keys (automation / ops tooling)
API_KEYS=

# ── OAuth (comma separated client IDs) ──
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=

# ── Notifications ──
# "log" | smtp://user:pass@smtp.example.com:587 | JSON {"host":"","port":587,"secure":false,"user":"","pass":""}
EMAIL_CONFIG=log
EMAIL_FROM=GoCrypto <no-reply@gocrypto.example>
# "log" | JSON {"provider":"twilio","url":"...","token":"...","from":"+1..."}
SMS_CONFIG=log
# log | expo
PUSH_PROVIDER=log
EXPO_ACCESS_TOKEN=

# ── Market data & engine ──
# SIMULATED (sandbox GBM feed) | EXTERNAL (live index from MARKET_DATA_URL, e.g. Binance public streams)
MARKET_DATA_MODE=SIMULATED
MARKET_DATA_URL=wss://stream.binance.com:9443/stream
MARKET_MAKER_ENABLED=true
BACKFILL_HISTORY=true
# redis = standalone matching-engine service | inprocess = engine runs inside the API (single node)
ENGINE_MODE=redis
ENGINE_REPLY_TIMEOUT_MS=3000
FUNDING_INTERVAL_HOURS=8

# ── Rate limits ──
RATE_LIMIT_MAX=600
RATE_LIMIT_WINDOW_MS=60000
ORDER_RATE_LIMIT_PER_SEC=20

# ── Seeding ──
SEED_ADMIN_EMAIL=admin@gocrypto.local
# Leave empty to generate a random password (printed once by `pnpm db:seed`)
SEED_ADMIN_PASSWORD=
SEED_DEMO_USER=true
