{
  "name": "@gocrypto/market-data",
  "version": "0.1.0",
  "private": true,
  "description": "Market data: index/mark prices, funding prediction, 24h tickers, candles (batched persistence), market maker and history backfill",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "start": "node dist/main.js",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@gocrypto/matching-engine": "workspace:*",
    "@gocrypto/risk-engine": "workspace:*",
    "@gocrypto/server-core": "workspace:*",
    "@gocrypto/shared-types": "workspace:*",
    "@gocrypto/trading-utils": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.5.1"
  }
}
