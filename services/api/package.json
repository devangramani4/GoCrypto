{
  "name": "@gocrypto/api",
  "version": "0.1.0",
  "private": true,
  "description": "GoCrypto REST API (Fastify, versioned under /api/v1)",
  "type": "module",
  "main": "./src/app.ts",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "start": "node dist/main.js",
    "build": "tsup src/main.ts --format esm --target node22 --out-dir dist --clean --sourcemap --no-splitting --external mysql2 --external ioredis --external bullmq --external @node-rs/argon2 --external pino --external prom-client --external fastify",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.3.0",
    "@fastify/swagger": "^9.9.5",
    "@fastify/swagger-ui": "^6.1.5",
    "@gocrypto/matching-engine": "workspace:*",
    "@gocrypto/risk-engine": "workspace:*",
    "@gocrypto/server-core": "workspace:*",
    "@gocrypto/shared-types": "workspace:*",
    "@gocrypto/trading-utils": "workspace:*",
    "@gocrypto/validation": "workspace:*",
    "fastify": "^5.12.8",
    "fastify-type-provider-zod": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@gocrypto/database": "workspace:*",
    "tsup": "^8.5.1"
  }
}
