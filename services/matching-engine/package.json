{
  "name": "@gocrypto/matching-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Price-time priority matching engine: pure order book, engine runner with atomic settlement, and in-process / Redis gateways",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "start": "node dist/main.js",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@gocrypto/server-core": "workspace:*",
    "@gocrypto/shared-types": "workspace:*",
    "@gocrypto/trading-utils": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.5.1"
  }
}
