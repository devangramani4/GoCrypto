{
  "name": "@gocrypto/websocket",
  "version": "0.1.0",
  "private": true,
  "description": "Socket.IO gateway: Redis pub/sub fan-out of market data and authenticated private user channels",
  "type": "module",
  "main": "./src/gateway.ts",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "start": "node dist/main.js",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@gocrypto/server-core": "workspace:*",
    "@gocrypto/shared-types": "workspace:*",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.4",
    "tsup": "^8.5.1"
  }
}
