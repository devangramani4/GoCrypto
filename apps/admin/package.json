{
  "name": "@gocrypto/admin",
  "version": "0.1.0",
  "private": true,
  "description": "GoCrypto admin back-office (RBAC)",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5174",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview --port 5174",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@gocrypto/api-client": "workspace:*",
    "@gocrypto/shared-types": "workspace:*",
    "@gocrypto/trading-utils": "workspace:*",
    "@gocrypto/ui": "workspace:*",
    "@gocrypto/validation": "workspace:*",
    "@tanstack/react-query": "^5.108.3",
    "lightweight-charts": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.6",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^27.0.1",
    "vite": "^8.3.8"
  }
