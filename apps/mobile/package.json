{
  "name": "@gocrypto/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "GoCrypto mobile app (bare React Native, no Expo) for iOS and Android",
  "main": "index.js",
  "scripts": {
    "start": "react-native start",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "pods": "cd ios && bundle install && bundle exec pod install",
    "bundle:android": "react-native bundle --platform android --dev false --entry-file index.js --bundle-output build/index.android.bundle --assets-dest build/android-res",
    "bundle:ios": "react-native bundle --platform ios --dev false --entry-file index.js --bundle-output build/main.jsbundle --assets-dest build/ios-assets",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@gocrypto/api-client": "workspace:*",
    "@gocrypto/shared-types": "workspace:*",
    "@gocrypto/trading-utils": "workspace:*",
    "@gocrypto/ui": "workspace:*",
    "@gocrypto/validation": "workspace:*",
    "@react-native-clipboard/clipboard": "^1.17.0",
    "@react-native-firebase/app": "^27.1.1",
    "@react-native-firebase/messaging": "^27.1.1",
    "@react-navigation/bottom-tabs": "^7.22.0",
    "@react-navigation/native": "^7.5.2",
    "@react-navigation/native-stack": "^7.21.1",
    "@tanstack/react-query": "^5.108.3",
    "qrcode-generator": "^2.0.4",
    "react": "19.3.1",
    "react-native": "0.88.1",
    "react-native-get-random-values": "^2.1.0",
    "react-native-haptic-feedback": "^3.0.0",
    "react-native-keychain": "^11.0.0",
    "react-native-permissions": "^5.6.3",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "socket.io-client": "^4.8.4",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/plugin-transform-export-namespace-from": "^7.29.15",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/jest-preset": "0.88.1",
    "@react-native/metro-config": "0.88.1",
    "@react-native/typescript-config": "0.88.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.3.0",
    "babel-plugin-transform-inline-environment-variables": "^0.4.4",
    "jest": "^29.6.3",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
